# 服务端口（短链跳转与管理 API 共用，API 固定使用 /api 保留路径）
PORT=3000

# [domain] 根路径默认跳转目标（必填建议，可留空）
DEFAULT_REDIRECT_URL=https://example.com

# 对外展示完整短链时使用的域名（如 https://s.example.com）
PUBLIC_LINK_DOMAIN=

# 随机 hash 长度（3-32）
HASH_LENGTH=6

# 删除/失效后保留天数
RETENTION_DAYS=7

# 核心管理员 Key（必填，仅环境变量配置）
ADMIN_KEY=

# SQLite 数据库文件路径
DATABASE_PATH=./data/yona-link.db

# 普通 API Key 生成时的可见前缀
API_KEY_PREFIX=yl_

# API 每分钟每 IP 请求上限
RATE_LIMIT_MAX=120

# 长期（permanent）链接跳转是否使用 301（默认 false 使用 302）
RESPONSE_301_FOR_PERMANENT=false
