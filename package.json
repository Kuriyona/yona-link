{
  "name": "kuriyona-links",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "pnpm --parallel --filter \"@kuriyona/*\" dev",
    "dev:worker": "pnpm --filter @kuriyona/links-worker dev",
    "dev:web": "pnpm --filter @kuriyona/links-web dev",
    "build": "pnpm --filter @kuriyona/links-web build",
    "deploy": "pnpm build && pnpm --filter @kuriyona/links-worker run deploy",
    "test": "pnpm --filter @kuriyona/links-worker test",
    "typecheck": "pnpm --filter @kuriyona/links-worker typecheck && pnpm --filter @kuriyona/links-web typecheck",
    "format": "oxfmt -c .oxfmtrc.json .",
    "format:check": "oxfmt -c .oxfmtrc.json --check .",
    "db:generate": "pnpm --filter @kuriyona/links-worker db:generate",
    "db:migrate:local": "pnpm --filter @kuriyona/links-worker db:migrate:local",
    "db:migrate:remote": "pnpm --filter @kuriyona/links-worker db:migrate:remote",
    "cf-typegen": "pnpm --filter @kuriyona/links-worker cf-typegen"
  },
  "devDependencies": {
    "oxfmt": "^0.62.0"
  }
}
